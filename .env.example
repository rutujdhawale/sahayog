# =================================================================
# Sahayog Platform - Environment Configuration Template
# Copy this file to .env and configure with your actual credentials
# =================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Client Application URL (used for CORS and OAuth redirect origins)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# MongoDB Atlas Connection String or Local MongoDB URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sahayog?retryWrites=true&w=majority
# Alternatively:
# MONGODB_URI=mongodb://localhost:27017/sahayog

# -----------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------
# Secret key used for signing JSON Web Tokens (min 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# -----------------------------------------------------------------
# Google OAuth 2.0 Credentials
# -----------------------------------------------------------------
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:5000
# 5. Add Authorized redirect URIs:
#    - http://localhost:5173
#    - http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------
# Cloudinary Configuration (Campaign Image Storage)
# -----------------------------------------------------------------
# Sign up at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# Email Configuration (Nodemailer - Contribution Receipts & Invoices)
# -----------------------------------------------------------------
# For Gmail: Use an App Password (not your normal password)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
